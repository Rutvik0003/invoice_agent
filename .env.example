# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
# SQLite locally; Supabase Postgres URL in production
DATABASE_URL=sqlite:///./local.db

# --- AI providers (free tiers) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Model names change over time: check each provider's current model list.
# GEMINI_MODEL should be a Flash model; GROQ_MODEL must be vision-capable (it receives page images).
# Chosen in Phase 3 (Oct 2026): gemini-2.5-flash was the newest Flash model that answered reliably
# (3.5/3.7/3.8 returned 503 "high demand"); qwen/qwen3.8-27b was Groq's only image-capable model.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=qwen/qwen3.8-27b
# Other Gemini models offered per run on New Run (comma-separated; checked against the API's model list, Oct 2026)
GEMINI_MODELS=gemini-2.5-flash,gemini-3.6-flash,gemini-3.8-flash
# Minimum seconds between two AI requests (free-tier rate limits); also editable in Settings
AI_REQUEST_GAP_S=6
# Which model the UI selects by default: gemini | groq
DEFAULT_MODEL=gemini

# --- Business rules ---
# A variance is acceptable if <= min(TOLERANCE_PCT % of value, TOLERANCE_ABS_INR)
TOLERANCE_PCT=1.0
TOLERANCE_ABS_INR=500
# Critical fields with confidence below this are "low confidence" -> Hold
CONFIDENCE_THRESHOLD=0.80
# PO inference (when the invoice has no PO reference)
PO_INFER_MIN_SCORE=0.85
PO_INFER_MIN_GAP=0.15
PO_INFER_FLOOR=0.50
# Same vendor + same total within this many days -> possible duplicate
POSSIBLE_DUP_DAYS=3

# --- Stage 3: verify on page (PDF text layer / Tesseract OCR) ---
VERIFY_ENABLED=true
# Resolution used when rendering scanned pages for OCR
OCR_DPI=300
# Ignore OCR words with confidence below this (0-100)
OCR_MIN_WORD_CONF=40
# Minimum RapidFuzz score (0-100) for invoice number / PO ref matches
VERIFY_FUZZY_MIN=90
# Optional full path to the tesseract binary if it is not on PATH,
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
